<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VehiculosMaui.Views.RegistrarVehiculoPage"
             Title="Nuevo Vehículo"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">
            
            <VerticalStackLayout Spacing="5" Margin="0,10">
                <Label Text="Alta de Unidad" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                <Label Text="Ingrese los datos de identificación del vehículo." FontSize="14" TextColor="{StaticResource Tertiary}" />
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="{StaticResource CardBackground}" Padding="25">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,4" Opacity="0.1" Radius="10"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="22">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="PLACA / MATRÍCULA" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" CharacterSpacing="1"/>
                        <Entry Text="{Binding Placa}" Placeholder="Ej: ABC-1234" TextTransform="Uppercase" MaxLength="10" />
                        <BoxView HeightRequest="1" Color="{StaticResource Secondary}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="MARCA" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Entry Text="{Binding Marca}" Placeholder="Nissan" />
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="MODELO" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Entry Text="{Binding Modelo}" Placeholder="Sentra" />
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="AÑO" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Entry Text="{Binding Anio}" Keyboard="Numeric" MaxLength="4" />
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="TIPO" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Picker SelectedItem="{Binding Tipo}" Title="Seleccionar...">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Sedán</x:String>
                                        <x:String>SUV</x:String>
                                        <x:String>Pick-up</x:String>
                                        <x:String>Carga</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12" Margin="0,15,0,30">
                <Button Text="Registrar Vehículo" 
                        Command="{Binding GuardarCommand}"
                        HeightRequest="55"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="20">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Opacity="0.25" Radius="12"/>
                    </Button.Shadow>
                </Button>

                <Button Text="Cancelar" 
                        Command="{Binding CancelarCommand}"
                        HeightRequest="55"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource PrimaryDark}"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        BorderColor="{StaticResource PrimaryDark}"
                        BorderWidth="1" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>