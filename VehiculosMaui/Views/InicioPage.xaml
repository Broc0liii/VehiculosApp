<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VehiculosMaui.Views.InicioPage"
             Title="Panel Principal"
             BackgroundColor="{StaticResource Background}">

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="25" Spacing="30">

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Bienvenido de nuevo"
                       TextColor="{StaticResource SecondaryDarkText}"
                       FontSize="16"
                       HorizontalOptions="Center"/>
                <Label Text="Gestión de Flota"
                       TextColor="{StaticResource Primary}"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *"
                  RowDefinitions="Auto, Auto"
                  ColumnSpacing="20"
                  RowSpacing="20">

                <!-- Botón Vehículos -->
                <Button Grid.Row="0" Grid.Column="0"
                        Text="Vehículos"
                        Command="{Binding NavegarAVehiculosCommand}"
                        HeightRequest="140"
                        BackgroundColor="{StaticResource CardBackground}"
                        TextColor="{StaticResource Primary}"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        BorderColor="{StaticResource Secondary}"
                        BorderWidth="1">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Opacity="0.1" Radius="10"/>
                    </Button.Shadow>
                </Button>

                <!-- Botón Mantenimientos -->
                <Button Grid.Row="0" Grid.Column="1"
                        Text="Mantenimientos"
                        Command="{Binding NavegarAMantenimientosCommand}"
                        HeightRequest="140"
                        BackgroundColor="{StaticResource CardBackground}"
                        TextColor="{StaticResource PrimaryDark}"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        BorderColor="{StaticResource Secondary}"
                        BorderWidth="1">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Opacity="0.1" Radius="10"/>
                    </Button.Shadow>
                </Button>

                <!-- Botón Fallas -->
                <Button Grid.Row="1" Grid.Column="0"
                        Text="Reportes Fallas"
                        Command="{Binding NavegarAFallasCommand}"
                        HeightRequest="140"
                        BackgroundColor="{StaticResource CardBackground}"
                        TextColor="{StaticResource Tertiary}"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        BorderColor="{StaticResource Secondary}"
                        BorderWidth="1">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Opacity="0.1" Radius="10"/>
                    </Button.Shadow>
                </Button>

                <!-- Botón Catálogos -->
                <Button Grid.Row="1" Grid.Column="1"
                        Text="Catálogos"
                        Command="{Binding NavegarACatalogosCommand}"
                        HeightRequest="140"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="20">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,6" Opacity="0.25" Radius="12"/>
                    </Button.Shadow>
                </Button>

            </Grid>

            <Label Text="Briana v1.0"
                   TextColor="{StaticResource Tertiary}"
                   FontSize="12"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>