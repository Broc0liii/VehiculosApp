<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VehiculosMaui.Views.RegistrarMantenimientoPage"
             Title="Registrar Servicio"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">
            
            <VerticalStackLayout Spacing="5" Margin="0,10">
                <Label Text="Nuevo Mantenimiento" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                <Label Text="Ingresa los datos del servicio realizado." FontSize="14" TextColor="{StaticResource Tertiary}" />
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="{StaticResource CardBackground}" Padding="25">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,4" Opacity="0.1" Radius="10"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="22">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="VEHÍCULO ID" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <Entry Placeholder="1" Keyboard="Numeric" />
                        <BoxView HeightRequest="1" Color="{StaticResource Secondary}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="TIPO DE SERVICIO" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Picker Title="Seleccionar...">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Preventivo</x:String>
                                        <x:String>Correctivo</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="COSTO ($)" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            <Entry Placeholder="0.00" Keyboard="Numeric" />
                            <BoxView HeightRequest="1" Color="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="FECHA DEL SERVICIO" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <DatePicker />
                        <BoxView HeightRequest="1" Color="{StaticResource Secondary}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12" Margin="0,15,0,30">
                <Button Text="Guardar Mantenimiento" 
                        HeightRequest="55"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="20">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Opacity="0.25" Radius="12"/>
                    </Button.Shadow>
                </Button>

                <Button Text="Cancelar" 
                        HeightRequest="55"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource PrimaryDark}"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        BorderColor="{StaticResource PrimaryDark}"
                        BorderWidth="1" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>