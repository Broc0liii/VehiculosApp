<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VehiculosMaui.Views.HistorialMantenimientosPage"
             Title="Mantenimientos"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Padding="25" Spacing="10">
            <Label Text="Historial de Mantenimientos" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
            <Label Text="Registro de servicios realizados a la flota." FontSize="14" TextColor="{StaticResource Tertiary}" />

            <Button Text="+ Nuevo Mantenimiento"
                    Command="{Binding NuevoMantenimientoCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="50"
                    Margin="0,15,0,0">
                <Button.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,4" Opacity="0.2" Radius="8"/>
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Command="{Binding LoadMantenimientosCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Mantenimientos}" Margin="20,0,20,20">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="{StaticResource CardBackground}" Margin="0,0,0,15" Padding="20">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Offset="0,4" Opacity="0.1" Radius="10"/>
                            </Border.Shadow>

                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                                <BoxView Grid.RowSpan="2" Grid.Column="0" WidthRequest="4" BackgroundColor="{StaticResource Secondary}" CornerRadius="2" Margin="0,0,15,0" />
                                
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding VehiculoId, StringFormat='Vehículo ID: {0}'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5" Margin="0,5,0,0">
                                    <Label Text="{Binding ServicioId, StringFormat='Servicio: {0}'}" FontSize="14" TextColor="{StaticResource Tertiary}" />
                                    <Label Text="{Binding Costo, StringFormat='Costo: ${0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    <Label Text="{Binding Fecha, StringFormat='Fecha: {0:dd/MM/yyyy}'}" FontSize="12" TextColor="{StaticResource Tertiary}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,50,0,0">
                        <Label Text="No hay mantenimientos registrados." FontSize="16" TextColor="{StaticResource Tertiary}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>