<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VehiculosMaui.Views.ListaVehiculosPage"
             Title="Flota de Vehículos"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Padding="25" Spacing="10">
            <Label Text="Tus Vehículos" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
            <Label Text="Administra los vehículos registrados en la flota." FontSize="14" TextColor="{StaticResource Tertiary}" />

            <Button Text="+ Añadir Vehículo"
                    Command="{Binding NuevoVehiculoCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="50"
                    Margin="0,15,0,0">
                <Button.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,4" Opacity="0.2" Radius="8"/>
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Command="{Binding LoadVehiculosCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Vehiculos}" Margin="20,0,20,20">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 15" StrokeThickness="0" BackgroundColor="{StaticResource CardBackground}" Margin="0,0,0,15" Padding="20">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Offset="0,4" Opacity="0.1" Radius="10"/>
                            </Border.Shadow>

                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                                <BoxView Grid.RowSpan="2" Grid.Column="0" WidthRequest="4" BackgroundColor="{StaticResource Primary}" CornerRadius="2" Margin="0,0,15,0" />
                                
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Placa}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5" Margin="0,5,0,0">
                                    <Label Text="{Binding Marca}" FontSize="14" TextColor="{StaticResource Tertiary}" />
                                    <Label Text="-" FontSize="14" TextColor="{StaticResource Tertiary}" />
                                    <Label Text="{Binding Modelo}" FontSize="14" TextColor="{StaticResource Tertiary}" />
                                    <Label Text="-" FontSize="14" TextColor="{StaticResource Tertiary}" />
                                    <Label Text="{Binding Anio}" FontSize="14" TextColor="{StaticResource Tertiary}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Margin="0,50,0,0">
                        <Label Text="No hay vehículos registrados." FontSize="16" TextColor="{StaticResource Tertiary}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>