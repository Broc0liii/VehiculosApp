<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VehiculosMaui.Views.CatalogosPage"
             Title="Catálogos"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Padding="25" Spacing="10">
            <Label Text="Catálogos del Sistema" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
            <Label Text="Información base para operaciones." FontSize="14" TextColor="{StaticResource Tertiary}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="25">
                    
                    <!-- Marcas -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Marcas de Vehículos" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <CollectionView ItemsSource="{Binding Marcas}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{StaticResource CardBackground}" Margin="0,0,0,10" Padding="15">
                                        <Label Text="{Binding Nombre}" TextColor="{StaticResource PrimaryDarkText}" FontSize="14" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Servicios -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Tipos de Servicios" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <CollectionView ItemsSource="{Binding Servicios}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{StaticResource CardBackground}" Margin="0,0,0,10" Padding="15">
                                        <Label Text="{Binding Nombre}" TextColor="{StaticResource PrimaryDarkText}" FontSize="14" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Estatus Fallas -->
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Estatus de Fallas" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <CollectionView ItemsSource="{Binding EstatusFallas}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{StaticResource CardBackground}" Margin="0,0,0,10" Padding="15">
                                        <Label Text="{Binding Nombre}" TextColor="{StaticResource PrimaryDarkText}" FontSize="14" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>

</ContentPage>